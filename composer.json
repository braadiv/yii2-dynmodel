{
	"name": "braadiv/yii2-dynmodel",
	"description": "PHP 8.4 LTS Modernized Fork of mirocow/yii2-eav (Dynamic Model & EAV for Yii2)",
	"license": "MIT",
	"keywords": ["yii2", "extension", "braadiv", "dynamic form", "dynamic model", "Generate dynamic model", "dynamic multiple models model", "eav", "php84"],
	"type": "yii2-extension",
	"authors": [
		{
			"name": "Braa Alsalahi",
			"email": "braaalsalahi2013@gmail.com"
		}
	],
	"minimum-stability": "dev",
	"require": {
		"php": ">=8.1 || ^8.2 || ^8.3 || ^8.4",
		"yiisoft/yii2": "^2.0.13"
	},
	"suggest": {
		"nxp/math-executor": "Required if using condition-based calculations in EavModel"
	},
	"replace": {
		"mirocow/yii2-eav": "*"
	},
	"autoload": {
		"psr-4": {
			"braadiv\\dynmodel\\": "./src"
		}
	}
}
